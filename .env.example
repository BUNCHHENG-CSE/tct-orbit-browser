# Release Channel: stable | nova | deep | canary (Default: stable)
APP_CHANNEL="canary"
VITE_APP_CHANNEL="canary"

# 100% Private Offline Storage (Default)
STORAGE_MODE="local"

# Optional User Data Directory Override (Defaults to system appData)
# TCT_ORBIT_DATA_DIR="C:/path/to/custom/user-data"

# Production Publishing (Optional - for updates / CI/CD)
# GH_TOKEN="ghp_yourPersonalAccessTokenHere"
# GITHUB_TOKEN="ghp_yourPersonalAccessTokenHere"

# Windows Code Signing (Eliminates SmartScreen "Unknown publisher" in Image 1)
# WIN_CSC_LINK="path/to/certificate.pfx"
# WIN_CSC_KEY_PASSWORD="certificate_password"

# Optional Database URL (if running Prisma tools / studio / external postgres)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional Electron Download Mirrors (use if direct downloads from GitHub Releases are blocked)
# ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
# ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com/mirrors/electron-builder-binaries/"

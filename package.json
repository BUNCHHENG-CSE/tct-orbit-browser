{
  "name": "tct-orbit",
  "productName": "TCT Orbit",
  "version": "0.1.2",
  "description": "TCT Orbit",
  "homepage": "https://tctorbit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/BUNCHHENG-CSE/tct-orbit-browser.git"
  },
  "main": "./out/main/index.js",
  "author": "TCT <support@tctorbit.com>",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['dist', 'out'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "predev": "node build/brand-dev-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:stable": "cross-env APP_CHANNEL=stable VITE_APP_CHANNEL=stable electron-vite build",
    "build:nova": "cross-env APP_CHANNEL=nova VITE_APP_CHANNEL=nova electron-vite build",
    "build:deep": "cross-env APP_CHANNEL=deep VITE_APP_CHANNEL=deep electron-vite build",
    "build:canary": "cross-env APP_CHANNEL=canary VITE_APP_CHANNEL=canary electron-vite build",
    "prepreview": "node build/brand-dev-electron.cjs",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:store": "electron-vite build && electron-builder --win appx --x64 --config electron-builder.store.cjs --publish never",
    "dist:win:arm64": "electron-vite build && electron-builder --win --arm64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64 --publish never",
    "dist:mac:universal": "electron-vite build && electron-builder --mac --universal --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --publish never",
    "dist:linux:deb": "electron-vite build && electron-builder --linux deb --publish never",
    "dist:linux:rpm": "electron-vite build && electron-builder --linux rpm --publish never",
    "dist:linux:pacman": "electron-vite build && electron-builder --linux pacman --publish never",
    "dist:linux:all": "electron-vite build && electron-builder --linux AppImage deb rpm pacman tar.gz --publish never",
    "dist:all": "electron-vite build && electron-builder -mwl --publish never",
    "dist:publish": "electron-vite build && electron-builder --publish always",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@ghostery/adblocker-electron-preload": "^2.20.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.1",
    "electron-updater": "^6.8.11",
    "electron-vite": "^3.1.0",
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "chokidar": "^4.0.3"
  },
  "allowScripts": {
    "electron@45.3.4": true
  }
}

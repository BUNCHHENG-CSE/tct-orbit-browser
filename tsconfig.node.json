{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "prisma/**/*",
    "shared/**/*",
    "src/types/**/*"
  ]
}

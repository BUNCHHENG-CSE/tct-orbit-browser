# ==============================================================================
# 1. Dependencies & Package Managers
# ==============================================================================
node_modules/
.pnp/
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ==============================================================================
# 2. Environment Variables, Secrets & Code Signing Keys
# ==============================================================================
.env
.env.*
!.env.example
*.local

# Certificates, keystores & private signing keys (critical for Electron release builds)
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.keystore
*.jks
csc-*.json

# ==============================================================================
# 3. Build Outputs, Packaging & Installers (electron-builder / electron-vite)
# Note: Do NOT ignore 'build/' as it contains static packaging icons and macOS entitlements.
# ==============================================================================
out/
dist/
dist-unpacked/
release/
builder-debug.yml
builder-effective-config.yaml
dev-app-update.yml

# Installer packages & distribution artifacts
*.exe
*.msi
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.pacman
*.snap
*.flatpak
*.zip
*.tar.gz
*.tar.xz
*.blockmap
latest*.yml
latest*.yaml

# ==============================================================================
# 4. Bundler, Vite & TypeScript Incremental Build Caches
# ==============================================================================
.vite/
.cache/
.turbo/
.parcel-cache/
*.tsbuildinfo

# Temporary bundled config files left behind when a dev/build run is interrupted
electron.vite.config.*.mjs
vite.config.*.timestamp-*.mjs
vite.config.*.timestamp-*.js

# ==============================================================================
# 5. Database, SQLite & Local Storage Files (Prisma / JSON Storage)
# ==============================================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# ==============================================================================
# 6. Electron Runtime, Crash Dumps & Development User Data
# ==============================================================================
crash-dumps/
Crashpad/
minidumps/
*.dmp
*.dump
userData/
User Data/
# Anchored to the repo root so source files with the same name are never silently ignored
/tct-orbit-data.json
/state.json
/history.json
/privacy-shield-prefs.json
/adblocker-cache.bin
orbit.db*
# Atomic-write temp files (*.tmp written before rename)
*.tmp

# ==============================================================================
# 7. Logs & Diagnostic Files
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
core.[0-9]*

# ==============================================================================
# 8. Testing & Code Coverage
# ==============================================================================
coverage/
.nyc_output/
*.lcov

# ==============================================================================
# 9. Linter & Formatter Caches
# ==============================================================================
.eslintcache
.stylelintcache
.prettiercache

# ==============================================================================
# 10. IDE & Editor Configurations
# ==============================================================================
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Visual Studio Code: retain team workspace configurations, ignore local user state
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
.vscode/*.log

# ==============================================================================
# 11. AI Assistants, Agents & Scratch Directories
# ==============================================================================
.gemini/
.claude/
.cursor/
scratch/
tmp/
temp/
.temp/

# ==============================================================================
